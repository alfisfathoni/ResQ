# ResQ Backend - contoh variabel lingkungan.
# Salin file ini menjadi .env lalu isi nilainya. JANGAN commit .env.
# Baris bertanda (WAJIB) membuat server menolak start bila kosong.

# --- Server ---
PORT=3000
NODE_ENV=development
# URL dasar backend, dipakai untuk tautan di email verifikasi dan reset password
APP_URL=http://localhost:3000
# Opsional. Isi hanya bila server berada di balik proxy hosting (Render, Railway, dll.)
# agar IP klien terbaca benar untuk rate limit. Angka = jumlah proxy di depan server
# (biasanya 1 di hosting). Kosong = tidak dipercaya (cocok untuk lokal).
# Hindari "true": semua hop dipercaya dan IP klien bisa dipalsukan.
TRUST_PROXY=

# --- Database (PostgreSQL / Neon) ---
# (WAJIB) Connection string PostgreSQL. Untuk Neon gunakan sslmode=require.
DATABASE_URL=

# --- JWT ---
# (WAJIB) Keempat secret harus berbeda satu sama lain dan acak, misalnya isi_dengan_nilai_acak
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_EMAIL_VERIFICATION_SECRET=
JWT_PASSWORD_RESET_SECRET=
# Opsional (masa berlaku token). Default: 15m, 7d, 1d, 1h
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_EMAIL_VERIFICATION_EXPIRES_IN=1d
JWT_PASSWORD_RESET_EXPIRES_IN=1h

# --- Hashing ---
# Opsional. Default 10
BCRYPT_SALT_ROUNDS=10

# --- Cloudinary (upload media laporan) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Opsional. Default resq/reports
CLOUDINARY_REPORT_FOLDER=resq/reports

# --- SMTP / Email ---
SMTP_HOST=
# Opsional. Default 587 (465 memakai TLS implisit).
# Di hosting gratis (Render, Railway) port 25/465/587 diblokir. Pakai 2525 untuk
# relay penyedia email (mis. Brevo atau Mailgun). Port 2525 memakai STARTTLS.
# Periksa dokumentasi penyedia untuk port dan kuota terbaru.
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Opsional. Default memakai SMTP_USER. Di relay penyedia, isi dengan alamat
# pengirim yang sudah diverifikasi di penyedia (SMTP_USER biasanya bukan alamat email).
SMTP_FROM=

# --- Rate limit ---
# Opsional. Maks request per IP per 15 menit. Naikkan bila banyak perangkat
# berbagi satu Wi-Fi saat demo. Nilai harus bilangan bulat >= 1.
# Login, register, forgot/reset password. Default: 20
AUTH_RATE_LIMIT_MAX=20
# Resend verification (mengirim email). Default: 5
EMAIL_RATE_LIMIT_MAX=5
# POST /api/auth/refresh (dipanggil otomatis oleh aplikasi). Default: 100
REFRESH_RATE_LIMIT_MAX=100

# --- Demo ---
# Bila true, akun baru langsung terverifikasi (isVerified=true) dan email
# verifikasi tidak dikirim. Hanya untuk dev lokal / demo saat SMTP mati.
# JANGAN aktifkan di produksi. Default: false
AUTO_VERIFY_EMAIL=false

# --- Seed (hanya dipakai oleh `npm run seed`) ---
# Akun ADMIN. ADMIN_EMAIL dan ADMIN_PASSWORD wajib saat menjalankan seed.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Opsional. Default admin
ADMIN_USERNAME=
# Opsional. Default ResQ Admin
ADMIN_FULL_NAME=
# Opsional. Format ^\+?\d{7,15}$ dan harus unik. Ada nilai default
ADMIN_PHONE=
# Isi true HANYA bila ingin menimpa password admin yang sudah ada. Default: tidak menimpa
SEED_RESET_ADMIN_PASSWORD=
# Bila diisi (8-72 karakter), seed membuat 2 user demo. Kosong = dilewati
SEED_DEMO_PASSWORD=
